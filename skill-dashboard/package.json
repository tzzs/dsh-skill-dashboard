{
  "name": "@local/dsh-skill-dashboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/client.test.mjs test/helpers.test.mjs test/apply.test.mjs test/preview.test.mjs test/usage-periods.test.mjs",
    "test:live": "node test/real-skills.test.mjs",
    "ci": "npm run check && npm test"
  },
  "description": "Skill dashboard: manage, install, update and switch off agent skills, detect the coding agents that read their skill directories, and report per-skill usage statistics.",
  "license": "MIT",
  "author": "tzzs",
  "homepage": "https://github.com/tzzs/dsh-skill-dashboard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tzzs/dsh-skill-dashboard.git",
    "directory": "skill-dashboard"
  },
  "bugs": {
    "url": "https://github.com/tzzs/dsh-skill-dashboard/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "skills",
    "dashboard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "test/*.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
